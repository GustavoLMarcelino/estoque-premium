# Rodar SÓ na EC2 de produção (a RDS não é alcançável de fora da VPC).
# Mesma connection string que o backend Node já usa em produção — reaproveite
# o valor do DATABASE_URL do .env do backend, idealmente com um usuário
# MySQL que só tenha SELECT em estoque/movimentacoes/marca (não o usuário
# de escrita do Node), já que este script nunca deveria precisar de mais que leitura.
DATABASE_URL="mysql://usuario:senha@host:3306/estoque_premium"
