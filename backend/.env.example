# Conexão com o banco MySQL (Prisma)
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://user:password@localhost:3306/estoque_premium"

# Segredo usado para assinar os tokens JWT
JWT_SECRET="troque-por-um-segredo-forte"

# Porta da API (opcional, padrão 3000)
PORT=3000

# Usuário admin padrão criado pelo seed (npm run seed)
ADMIN_EMAIL="gustavoavomarcelino@gmail.com"
ADMIN_PASSWORD="troque-por-uma-senha-forte-antes-de-rodar-o-seed"

# SMTP para o email de "esqueci minha senha" (mesmos valores usados nos
# secrets do GitHub Actions, mas aqui lidos pelo backend na EC2)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="seu-email@gmail.com"
SMTP_PASSWORD="app-password-do-gmail"

# URL(s) do frontend: allowlist do CORS e base do link de redefinição de
# senha (se houver mais de uma origem separada por vírgula, o link usa a 1ª)
FRONTEND_URL="https://premiumbateriasbv.com.br"
