# Pronto para desenvolvimento local: `cp backend/.env.example backend/.env`
# funciona sem editar nada. Em produção (EC2) os valores são outros — nunca
# versione o .env real.

# Banco de desenvolvimento (SQLite, schema.prisma). Caminho relativo à pasta
# prisma/ — o arquivo fica em backend/prisma/dev.db (ignorado pelo git).
DATABASE_URL="file:./dev.db"

# Banco de produção (MySQL/RDS, schema.mysql.prisma). Só é lido com
# NODE_ENV=production. Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# DATABASE_URL_MYSQL="mysql://user:password@localhost:3306/estoque_premium"

# development → client SQLite; production → client MySQL (config/prisma.js)
NODE_ENV=development

# Segredo dos tokens JWT — o backend aborta se tiver menos de 32 caracteres.
# Este valor é SÓ para dev; em produção gere outro (ex.: openssl rand -hex 32).
JWT_SECRET="dev-somente-local-troque-em-producao-0123456789abcdef"

# Porta da API (opcional, padrão 3000)
PORT=3000

# Admin criado pelo seed (npm run seed). Troque a senha fora do dev.
ADMIN_EMAIL="admin@estoquepremium.com"
ADMIN_PASSWORD="admin-dev-123"

# URL(s) do frontend: allowlist do CORS e base do link de redefinição de
# senha (se houver mais de uma origem separada por vírgula, o link usa a 1ª)
FRONTEND_URL="http://localhost:5173"

# SMTP para o email de "esqueci minha senha". Sem SMTP, fora de produção, o
# link de redefinição só é logado no console — não é preciso para dev.
# SMTP_SERVER="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USERNAME="seu-email@gmail.com"
# SMTP_PASSWORD="app-password-do-gmail"
