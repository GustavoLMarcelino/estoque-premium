// PRODUCTION SCHEMA (MySQL / RDS).
// Mantido como backup ao usar SQLite em desenvolvimento local.
// Para voltar ao MySQL: copie este arquivo sobre schema.prisma e ajuste DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_MYSQL")
}

// Marcas dos produtos (compartilhada entre baterias e som).
// Desativar (ativo=false) esconde do dropdown sem quebrar produtos existentes.
model marca {
  id          Int           @id @default(autoincrement())
  nome        String        @unique @db.VarChar(80)
  ativo       Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.DateTime(0)
  estoques    estoque[]
  estoques_som estoque_som[]
}

// Classe de serviço do Estoque Som: carrega um valor fixo de mão de obra,
// somado no Orçamento e na Tabela de Preços (aba Som). Editável pela gestão.
model classe_som {
  id             Int               @id @default(autoincrement())
  nome           String            @unique @db.VarChar(80)
  valor_mao_obra Decimal           @db.Decimal(10, 2)
  categoria      String            @default("SOM") @db.VarChar(20) // SOM | INSULFILME
  ativo          Boolean           @default(true)
  created_at     DateTime          @default(now()) @db.DateTime(0)
  estoques_som   estoque_som[]
  pedido_itens   pedido_som_item[]
}

model estoque {
  id               Int             @id @default(autoincrement())
  produto          String          @db.VarChar(100)
  modelo           String          @db.VarChar(100)
  marca_id         Int
  custo            Decimal         @db.Decimal(10, 2)
  valor_venda      Decimal         @db.Decimal(10, 2)
  percentual_lucro Decimal?        @db.Decimal(5, 2)
  qtd_minima       Int
  garantia         String?         @db.VarChar(50)
  qtd_inicial      Int
  entradas         Int?            @default(0)
  saidas           Int?            @default(0)
  em_estoque       Int?
  valor_vista      Decimal?        @db.Decimal(10, 2) // à vista (débito)
  valor_parcelado  Decimal?        @db.Decimal(10, 2) // parcelado 10x
  marca            marca           @relation(fields: [marca_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_estoque_marca")
  garantias        garantias[]
  movimentacoes    movimentacoes[]

  @@index([marca_id], map: "idx_estoque_marca")
}

model movimentacoes {
  id                Int                @id @default(autoincrement())
  produto_id        Int
  garantia_id       Int?
  tipo              movimentacoes_tipo
  quantidade        Int
  valor_final       Decimal            @db.Decimal(10, 2)
  motivo            String?            @db.VarChar(100)
  vendedor          String?            @db.VarChar(50) // vendedor responsável (saídas)
  // Venda (SAIDA): dinheiro | pix | debito | credito. parcelas só em crédito (1–10).
  forma_pagamento   String?            @db.VarChar(20)
  parcelas          Int?
  /// PAGO = recebido na saída. FIADO = cliente levou e paga depois.
  /// NÃO muda o regime: a venda entra em faturamento/lucro na SAÍDA, paga ou
  /// não (competência). O "a receber" do dashboard é um recorte do que já está
  /// em vendasBrutas. Também NÃO afeta comissão — a apuração conta unidades por
  /// vendedor e não olha pagamento.
  status_pagamento  movimentacoes_status_pagamento @default(PAGO)
  /// Quando o fiado foi quitado. NULL na venda paga na hora (o pagamento é a
  /// própria data_movimentacao) e no fiado ainda em aberto.
  data_pagamento    DateTime?          @db.DateTime(0)
  /// Nome do cliente que levou fiado. Texto livre — não existe cadastro de
  /// cliente no sistema, e criar um por causa disto seria caro demais para o
  /// que resolve: o dado serve para alguém ler na tela e lembrar de quem
  /// cobrar, não para relacionar nem faturar. NULL em venda paga na hora.
  /// VarChar(150) por paridade com garantias.cliente_nome.
  cliente_fiado     String?            @db.VarChar(150)
  data_movimentacao DateTime?          @default(now()) @db.DateTime(0)
  user_id           Int?
  created_by        String?            @db.VarChar(120) // nome/email do usuário no momento da criação
  estoque           estoque            @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_produto")

  @@index([produto_id], map: "fk_produto")
  @@index([garantia_id], map: "idx_mov_garantia")
  @@index([motivo], map: "idx_mov_motivo")
  @@index([status_pagamento], map: "idx_mov_status_pagamento")
}

model garantias {
  id                 Int              @id @default(autoincrement())
  cliente_nome       String           @db.VarChar(150)
  cliente_documento  String           @db.VarChar(20)
  cliente_telefone   String           @db.VarChar(20)
  cliente_endereco   String           @db.VarChar(255)
  produto_codigo     String           @db.VarChar(60)
  produto_descricao  String           @db.VarChar(255)
  estoque_id         Int?
  data_abertura      DateTime         @default(now()) @db.DateTime(0)
  data_limite        DateTime?        @db.DateTime(0)
  data_contato       DateTime?        @db.DateTime(0)
  data_compra        DateTime?        @db.DateTime(0)
  status             garantias_status @default(AGUARDANDO_ENVIO)
  descricao_problema String?          @db.Text
  // Resultado do teste da distribuidora, registrado quando a bateria volta
  // à loja (fase EM_LOJA): NOVA (troca) ou MESMA (recarregada). laudo = texto
  // livre do parecer. Anexo de arquivo fica para uma evolução futura.
  resultado          String?          @db.VarChar(10)
  laudo              String?          @db.Text
  // Empréstimo (bateria cedida ao cliente enquanto o produto está em garantia).
  // Eixo independente do status acima. Sem estes campos a baixa de estoque da
  // ida seria irreversível.
  emprestimo_produto_id   Int?
  emprestimo_quantidade   Int?
  emprestimo_devolvido    Boolean          @default(false)
  emprestimo_devolvido_at DateTime?        @db.DateTime(0)
  created_at         DateTime         @default(now()) @db.DateTime(0)
  updated_at         DateTime         @default(now()) @db.DateTime(0)
  estoque            estoque?         @relation(fields: [estoque_id], references: [id], map: "fk_garantias_estoque")

  @@index([estoque_id], map: "fk_garantias_estoque")
  @@index([data_limite], map: "idx_garantias_data_limite")
}

enum movimentacoes_tipo {
  ENTRADA
  SAIDA
}

/// Só faz sentido em SAIDA de Baterias. ENTRADA é compra do fornecedor — o
/// pagamento a ele não é modelado aqui e o POST força PAGO.
enum movimentacoes_status_pagamento {
  PAGO
  FIADO
}

enum garantias_status {
  AGUARDANDO_ENVIO
  RECOLHIDA
  EM_LOJA
  FINALIZADA
}

model user {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(120)
  email              String    @unique @db.VarChar(200)
  password           String    @db.VarChar(200) // hash
  role               String    @default("user") @db.VarChar(20)
  // Permissões granulares por tela (JSON de booleans, ex.: {"home":true}).
  // Chave ausente = false. role=admin BYPASSA tudo (não depende deste campo).
  // VarChar (não TEXT/JSON) para aceitar DEFAULT literal no MySQL do RDS.
  permissoes         String    @default("{}") @db.VarChar(2000)
  reset_token        String?   @db.VarChar(64) // sha256 do token de redefinição de senha (uso único)
  reset_token_expira DateTime? @db.DateTime(0)
  created_at         DateTime  @default(now()) @db.DateTime(0)
  updated_at         DateTime  @default(now()) @updatedAt @db.DateTime(0)
}

model estoque_som {
  id               Int                   @id @default(autoincrement())
  produto          String                @db.VarChar(100)
  modelo           String                @db.VarChar(100)
  marca_id         Int
  classe_id        Int?
  custo            Decimal               @db.Decimal(10, 2)
  valor_venda      Decimal               @db.Decimal(10, 2)
  percentual_lucro Decimal?              @db.Decimal(5, 2)
  qtd_minima       Int
  garantia         String?               @db.VarChar(50)
  qtd_inicial      Int
  entradas         Int?                  @default(0)
  saidas           Int?                  @default(0)
  em_estoque       Int?
  valor_vista      Decimal?              @db.Decimal(10, 2) // à vista (débito)
  valor_parcelado  Decimal?              @db.Decimal(10, 2) // parcelado 10x
  created_at       DateTime?             @db.DateTime(0)
  updated_at       DateTime?             @db.DateTime(0)
  marca            marca                 @relation(fields: [marca_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_estoque_som_marca")
  classe           classe_som?           @relation(fields: [classe_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_estoque_som_classe")
  movimentacoes    movimentacoes_som[]

  @@index([marca_id], map: "idx_estoque_som_marca")
  @@index([classe_id], map: "idx_estoque_som_classe")
  @@map("estoque_som")
}

model movimentacoes_som {
  id                Int                @id @default(autoincrement())
  produto_id        Int
  garantia_id       Int?
  tipo              movimentacoes_tipo
  quantidade        Int
  valor_final       Decimal            @db.Decimal(10, 2)
  motivo            String?            @db.VarChar(100)
  data_movimentacao DateTime?          @default(now()) @db.DateTime(0)
  user_id           Int?
  created_by        String?            @db.VarChar(120) // nome/email do usuário no momento da criação
  estoque           estoque_som        @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mov_som_produto")

  @@index([produto_id], map: "idx_mov_som_produto")
  @@index([garantia_id], map: "idx_mov_som_garantia")
  @@index([motivo], map: "idx_mov_som_motivo")
  @@map("movimentacoes_som")
}

model pedido_som {
  id              Int               @id @default(autoincrement())
  veiculo         String?           @db.VarChar(100)
  valor_total     Decimal           @db.Decimal(10, 2)
  valor_mao_obra  Decimal?          @db.Decimal(10, 2) // total (Som + Insulfilme)
  valor_mao_obra_insulfilme Decimal? @db.Decimal(10, 2) // porção Insulfilme
  comissao_joel   Decimal?          @db.Decimal(10, 2) // som×%som + insulfilme×%insulfilme
  // Rótulo do pagamento ("PIX", "Crédito 10x"…). parcelas só no crédito (1–10),
  // espelhando movimentacoes (Baterias). NÃO afeta preço: crédito usa o
  // valor_parcelado em qualquer nº de parcelas — o dado é insumo de apuração
  // de taxa de maquininha, que ainda não é calculada para Som.
  forma_pagamento String?           @db.VarChar(50)
  parcelas        Int?
  user_id         Int?
  created_by      String?           @db.VarChar(120)
  created_at      DateTime          @default(now()) @db.DateTime(0)
  itens           pedido_som_item[]

  @@map("pedido_som")
}

model pedido_som_item {
  id             Int         @id @default(autoincrement())
  pedido_id      Int
  tipo           String      @db.VarChar(20) // PRODUTO | MAO_OBRA
  produto_id     Int? // null para mão de obra
  classe_id      Int? // classe do serviço (produto-com-classe ou serviço avulso)
  descricao      String      @db.VarChar(150) // nome livre para mão de obra
  quantidade     Int         @default(1)
  valor_unit     Decimal     @db.Decimal(10, 2)
  valor_total    Decimal     @db.Decimal(10, 2)
  mao_obra_unit  Decimal?    @db.Decimal(10, 2) // snapshot de classe.valor_mao_obra no momento do pedido
  mao_obra_total Decimal?    @db.Decimal(10, 2) // quantidade × mao_obra_unit
  baixa_estoque  Boolean     @default(false)
  pedido         pedido_som  @relation(fields: [pedido_id], references: [id], onDelete: Cascade, map: "fk_pedido_som_item")
  classe         classe_som? @relation(fields: [classe_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedido_som_item_classe")

  @@index([pedido_id], map: "idx_pedido_som_item_pedido")
  @@index([produto_id], map: "idx_pedido_som_item_produto")
  @@index([classe_id], map: "idx_pedido_som_item_classe")
  @@map("pedido_som_item")
}

model conferencia_estoque {
  id             Int                   @id @default(autoincrement())
  linha          String                @db.VarChar(20) // BATERIAS | SOM
  status         String                @default("EM_ANDAMENTO") @db.VarChar(20) // EM_ANDAMENTO | FINALIZADA
  user_id        Int
  created_by     String                @db.VarChar(120)
  created_at     DateTime              @default(now()) @db.DateTime(0)
  finalizada_at  DateTime?             @db.DateTime(0)
  // Quem FINALIZOU (≠ created_by, que é quem iniciou: com pausar/retomar podem
  // ser pessoas diferentes).
  finalizada_por_id Int?
  finalizada_por    String?            @db.VarChar(120)
  // Resumo CONGELADO na finalização: continua verdadeiro para sempre e a
  // listagem não precisa carregar os itens. NULL = conferência anterior a este
  // registro (a tela mostra "—", sem inventar número retroativo).
  total_itens        Int?
  total_conferidos   Int?
  total_divergencias Int?
  itens          conferencia_item[]

  @@index([linha], map: "idx_conf_linha")
  @@index([status], map: "idx_conf_status")
  @@index([user_id], map: "idx_conf_user")
}

model conferencia_item {
  id              Int                  @id @default(autoincrement())
  conferencia_id  Int
  produto_id      Int
  linha           String               @db.VarChar(20) // BATERIAS | SOM
  qtd_sistema     Int
  // Quantidade REAL contada. NULL = não conferido. Um toque ("bateu") grava
  // qtd_contada = qtd_sistema; "Divergiu" grava o número digitado.
  qtd_contada     Int?
  conferido       Boolean              @default(false)
  conferido_at    DateTime?            @db.DateTime(0)
  conferencia     conferencia_estoque  @relation(fields: [conferencia_id], references: [id], onDelete: Cascade, map: "fk_conf_item_conferencia")

  @@index([conferencia_id], map: "idx_conf_item_conferencia")
  @@index([produto_id], map: "idx_conf_item_produto")
}

// ---- Comissão de vendedores (fechamento quinzenal: dia 1–15 e 16–fim do mês) ----
// Config editável pela gestão. percentual_mao_obra é guardado como PERCENTUAL
// (ex.: 30.00 = 30%); o cálculo divide por 100.
model comissao_config {
  id                    Int      @id @default(autoincrement())
  valor_bateria         Decimal  @db.Decimal(10, 2) // R$ fixos por bateria (Gustavo/Ismael)
  percentual_mao_obra   Decimal  @db.Decimal(5, 2) // % sobre a mão de obra de Som (Joel)
  percentual_insulfilme Decimal  @default(25) @db.Decimal(5, 2) // % sobre Insulfilme (Joel)
  updated_at            DateTime @default(now()) @db.DateTime(0)
  updated_by            String?  @db.VarChar(120)

  @@map("comissao_config")
}

// ---- Taxas de maquininha (percentuais 0–100; ex.: 1.36 = 1,36%) ----
// Singleton editável só por admin. Usada pelo /movimentacoes/resumo para
// calcular taxa e lucro líquido no servidor (modelo em src/utils/taxas.js).
model taxas_config {
  id                  Int      @id @default(autoincrement())
  pix_pct             Decimal  @db.Decimal(5, 2)
  debito_pct          Decimal  @db.Decimal(5, 2)
  credito_avista_pct  Decimal  @db.Decimal(5, 2) // crédito 1x
  credito_2a6_pct     Decimal  @db.Decimal(5, 2) // intermediação 2x–6x (sem antecipação)
  credito_7a12_pct    Decimal  @db.Decimal(5, 2) // intermediação 7x–12x (sem antecipação)
  antecipacao_mes_pct Decimal  @db.Decimal(5, 2) // % ao mês (desconto composto a valor presente)
  updated_at          DateTime @default(now()) @db.DateTime(0)
  updated_by          String?  @db.VarChar(120)

  @@map("taxas_config")
}

// Histórico de um período já fechado. Snapshot: não é recalculado depois.
model comissao_periodo {
  id          Int                     @id @default(autoincrement())
  data_inicio DateTime                @db.DateTime(0)
  data_fim    DateTime                @db.DateTime(0)
  fechado_at  DateTime                @default(now()) @db.DateTime(0)
  itens       comissao_periodo_item[]

  @@index([data_inicio], map: "idx_comissao_periodo_inicio")
  @@map("comissao_periodo")
}

model comissao_periodo_item {
  id                 Int              @id @default(autoincrement())
  periodo_id         Int
  vendedor           String           @db.VarChar(50)
  qtd_baterias       Int              @default(0)
  base_mao_obra      Decimal          @default(0) @db.Decimal(10, 2) // base de Som (Joel)
  base_insulfilme    Decimal          @default(0) @db.Decimal(10, 2) // base de Insulfilme (Joel)
  valor_comissao     Decimal          @default(0) @db.Decimal(10, 2)
  snap_valor_bateria Decimal          @db.Decimal(10, 2) // config vigente no fechamento
  snap_percentual    Decimal          @db.Decimal(5, 2) // % Som
  snap_percentual_insulfilme Decimal  @default(0) @db.Decimal(5, 2) // % Insulfilme
  periodo            comissao_periodo @relation(fields: [periodo_id], references: [id], onDelete: Cascade, map: "fk_comissao_periodo_item")

  @@index([periodo_id], map: "idx_comissao_periodo_item_periodo")
  @@map("comissao_periodo_item")
}

/// Diário append-only de exclusão/edição de venda. NUNCA é atualizado nem
/// apagado pelo app: cada operação destrutiva acrescenta uma linha.
///
/// Existe porque excluir venda é hard-delete — a linha some e, sem isto, não
/// resta rastro de quem apagou nem do que havia ali. Fica em tabela À PARTE de
/// propósito: nenhum leitor de venda (dashboard, comissão, listagens) precisa
/// passar a filtrar nada, ao contrário de um soft-delete, em que esquecer um
/// filtro faz número de dinheiro sair errado.
///
/// SEM foreign key para venda (ela deixou de existir) nem para user (apagar um
/// usuário não pode derrubar nem travar o histórico). entidade + entidade_id
/// guardam a referência solta, e feito_por congela o e-mail do momento.
model venda_auditoria {
  id          Int    @id @default(autoincrement())
  linha       String @db.VarChar(20) // baterias | som
  entidade    String @db.VarChar(40) // movimentacoes | movimentacoes_som | pedido_som
  entidade_id Int // id que a linha TINHA antes de sumir
  acao        String @db.VarChar(20) // EXCLUSAO | EDICAO (edição ainda não existe)
  /// Snapshot JSON do estado anterior, serializado com JSON.stringify.
  /// String (e não Json) porque o SQLite de dev não tem escalar Json: com Json
  /// aqui e String lá, a MESMA escrita gravaria objeto em prod e texto em dev —
  /// divergência que a suíte (SQLite) não pegaria. Mesmo padrão de user.permissoes.
  conteudo_anterior String   @db.LongText
  user_id           Int?
  feito_por         String?  @db.VarChar(120)
  feito_em          DateTime @default(now()) @db.DateTime(0)

  @@index([entidade, entidade_id], map: "idx_venda_auditoria_entidade")
  @@map("venda_auditoria")
}
