// LOCAL DEV SCHEMA (SQLite).
// O schema de produção (MySQL/RDS) está preservado em schema.mysql.prisma.
// Diferenças para SQLite: sem tipos nativos @db.*, e os enums viram String.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Marcas dos produtos (compartilhada entre baterias e som).
// Desativar (ativo=false) esconde do dropdown sem quebrar produtos existentes.
model marca {
  id          Int           @id @default(autoincrement())
  nome        String        @unique
  ativo       Boolean       @default(true)
  created_at  DateTime      @default(now())
  estoques    estoque[]
  estoques_som estoque_som[]
}

// Classe de serviço do Estoque Som: carrega um valor fixo de mão de obra,
// somado no Orçamento e na Tabela de Preços (aba Som). Editável pela gestão.
model classe_som {
  id             Int               @id @default(autoincrement())
  nome           String            @unique
  valor_mao_obra Decimal
  ativo          Boolean           @default(true)
  created_at     DateTime          @default(now())
  estoques_som   estoque_som[]
  pedido_itens   pedido_som_item[]
}

model estoque {
  id               Int             @id @default(autoincrement())
  produto          String
  modelo           String
  marca_id         Int
  custo            Decimal
  valor_venda      Decimal
  percentual_lucro Decimal?
  qtd_minima       Int
  garantia         String?
  qtd_inicial      Int
  entradas         Int?            @default(0)
  saidas           Int?            @default(0)
  em_estoque       Int?
  valor_vista      Decimal? // à vista (débito)
  valor_parcelado  Decimal? // parcelado 10x
  marca            marca           @relation(fields: [marca_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  garantias        garantias[]
  movimentacoes    movimentacoes[]

  @@index([marca_id], map: "idx_estoque_marca")
}

model movimentacoes {
  id                Int       @id @default(autoincrement())
  produto_id        Int
  garantia_id       Int?
  tipo              String // ENTRADA | SAIDA
  quantidade        Int
  valor_final       Decimal
  motivo            String?
  vendedor          String? // vendedor responsável (saídas)
  data_movimentacao DateTime? @default(now())
  user_id           Int?
  created_by        String? // nome/email do usuário no momento da criação
  estoque           estoque   @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([produto_id], map: "fk_produto")
  @@index([garantia_id], map: "idx_mov_garantia")
  @@index([motivo], map: "idx_mov_motivo")
}

model garantias {
  id                 Int       @id @default(autoincrement())
  cliente_nome       String
  cliente_documento  String
  cliente_telefone   String
  cliente_endereco   String
  produto_codigo     String
  produto_descricao  String
  estoque_id         Int?
  data_abertura      DateTime  @default(now())
  data_limite        DateTime?
  data_contato       DateTime?
  data_compra        DateTime?
  status             String    @default("AGUARDANDO_ENVIO") // AGUARDANDO_ENVIO | RECOLHIDA | EM_LOJA | FINALIZADA
  descricao_problema String?
  // Resultado do teste da distribuidora (fase EM_LOJA): NOVA | MESMA. laudo =
  // parecer em texto livre. Anexo de arquivo fica para evolução futura.
  resultado          String?
  laudo              String?
  // Empréstimo (bateria cedida ao cliente enquanto o produto está em garantia).
  // Eixo independente do status acima. Sem estes campos a baixa de estoque da
  // ida seria irreversível.
  emprestimo_produto_id   Int?
  emprestimo_quantidade   Int?
  emprestimo_devolvido    Boolean   @default(false)
  emprestimo_devolvido_at DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now())
  estoque            estoque?  @relation(fields: [estoque_id], references: [id])

  @@index([estoque_id], map: "fk_garantias_estoque")
  @@index([data_limite], map: "idx_garantias_data_limite")
}

model user {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  password           String // hash
  role               String    @default("user")
  reset_token        String? // sha256 do token de redefinição de senha (uso único)
  reset_token_expira DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt
}

model estoque_som {
  id               Int                 @id @default(autoincrement())
  produto          String
  modelo           String
  marca_id         Int
  classe_id        Int?
  custo            Decimal
  valor_venda      Decimal
  percentual_lucro Decimal?
  qtd_minima       Int
  garantia         String?
  qtd_inicial      Int
  entradas         Int?                @default(0)
  saidas           Int?                @default(0)
  em_estoque       Int?
  valor_vista      Decimal? // à vista (débito)
  valor_parcelado  Decimal? // parcelado 10x
  created_at       DateTime?
  updated_at       DateTime?
  marca            marca               @relation(fields: [marca_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classe           classe_som?         @relation(fields: [classe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movimentacoes    movimentacoes_som[]

  @@index([marca_id], map: "idx_estoque_som_marca")
  @@index([classe_id], map: "idx_estoque_som_classe")
  @@map("estoque_som")
}

model movimentacoes_som {
  id                Int         @id @default(autoincrement())
  produto_id        Int
  garantia_id       Int?
  tipo              String // ENTRADA | SAIDA
  quantidade        Int
  valor_final       Decimal
  motivo            String?
  data_movimentacao DateTime?   @default(now())
  user_id           Int?
  created_by        String? // nome/email do usuário no momento da criação
  estoque           estoque_som @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([produto_id], map: "idx_mov_som_produto")
  @@index([garantia_id], map: "idx_mov_som_garantia")
  @@index([motivo], map: "idx_mov_som_motivo")
  @@map("movimentacoes_som")
}

model pedido_som {
  id              Int               @id @default(autoincrement())
  veiculo         String?
  valor_total     Decimal
  valor_mao_obra  Decimal?
  comissao_joel   Decimal? // 30% do valor_mao_obra
  forma_pagamento String?
  user_id         Int?
  created_by      String?
  created_at      DateTime          @default(now())
  itens           pedido_som_item[]

  @@map("pedido_som")
}

model pedido_som_item {
  id             Int         @id @default(autoincrement())
  pedido_id      Int
  tipo           String // PRODUTO | MAO_OBRA
  produto_id     Int? // null para mão de obra
  classe_id      Int? // classe do serviço (produto-com-classe ou serviço avulso)
  descricao      String // nome livre para mão de obra
  quantidade     Int         @default(1)
  valor_unit     Decimal
  valor_total    Decimal
  mao_obra_unit  Decimal? // snapshot de classe.valor_mao_obra no momento do pedido
  mao_obra_total Decimal? // quantidade × mao_obra_unit
  baixa_estoque  Boolean     @default(false)
  pedido         pedido_som  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  classe         classe_som? @relation(fields: [classe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([pedido_id], map: "idx_pedido_som_item_pedido")
  @@index([produto_id], map: "idx_pedido_som_item_produto")
  @@index([classe_id], map: "idx_pedido_som_item_classe")
  @@map("pedido_som_item")
}

model conferencia_estoque {
  id            Int                @id @default(autoincrement())
  linha         String // BATERIAS | SOM
  status        String             @default("EM_ANDAMENTO") // EM_ANDAMENTO | FINALIZADA
  user_id       Int
  created_by    String
  created_at    DateTime           @default(now())
  finalizada_at DateTime?
  itens         conferencia_item[]

  @@index([linha], map: "idx_conf_linha")
  @@index([status], map: "idx_conf_status")
  @@index([user_id], map: "idx_conf_user")
}

model conferencia_item {
  id             Int                 @id @default(autoincrement())
  conferencia_id Int
  produto_id     Int
  linha          String // BATERIAS | SOM
  qtd_sistema    Int
  conferido      Boolean             @default(false)
  conferido_at   DateTime?
  conferencia    conferencia_estoque @relation(fields: [conferencia_id], references: [id], onDelete: Cascade)

  @@index([conferencia_id], map: "idx_conf_item_conferencia")
  @@index([produto_id], map: "idx_conf_item_produto")
}

// ---- Comissão de vendedores (fechamento quinzenal: dia 1–15 e 16–fim do mês) ----
// Config editável pela gestão. percentual_mao_obra é guardado como PERCENTUAL
// (ex.: 30.00 = 30%); o cálculo divide por 100.
model comissao_config {
  id                  Int      @id @default(autoincrement())
  valor_bateria       Decimal // R$ fixos por bateria vendida (Gustavo/Ismael)
  percentual_mao_obra Decimal // % sobre a mão de obra realizada (Joel)
  updated_at          DateTime @default(now())
  updated_by          String?
}

// Histórico de um período já fechado. Snapshot: não é recalculado depois.
model comissao_periodo {
  id          Int                     @id @default(autoincrement())
  data_inicio DateTime
  data_fim    DateTime
  fechado_at  DateTime                @default(now())
  itens       comissao_periodo_item[]

  @@index([data_inicio], map: "idx_comissao_periodo_inicio")
}

model comissao_periodo_item {
  id                 Int              @id @default(autoincrement())
  periodo_id         Int
  vendedor           String
  qtd_baterias       Int              @default(0)
  base_mao_obra      Decimal          @default(0) // base de mão de obra (Joel)
  valor_comissao     Decimal          @default(0)
  snap_valor_bateria Decimal // config vigente no fechamento (auditoria)
  snap_percentual    Decimal
  periodo            comissao_periodo @relation(fields: [periodo_id], references: [id], onDelete: Cascade)

  @@index([periodo_id], map: "idx_comissao_periodo_item_periodo")
}
