// LOCAL DEV SCHEMA (SQLite).
// O schema de produção (MySQL/RDS) está preservado em schema.mysql.prisma.
// Diferenças para SQLite: sem tipos nativos @db.*, e os enums viram String.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Marcas dos produtos (compartilhada entre baterias e som).
// Desativar (ativo=false) esconde do dropdown sem quebrar produtos existentes.
model marca {
  id          Int           @id @default(autoincrement())
  nome        String        @unique
  ativo       Boolean       @default(true)
  created_at  DateTime      @default(now())
  estoques    estoque[]
  estoques_som estoque_som[]
}

model estoque {
  id               Int             @id @default(autoincrement())
  produto          String
  modelo           String
  marca_id         Int
  custo            Decimal
  valor_venda      Decimal
  percentual_lucro Decimal?
  qtd_minima       Int
  garantia         String?
  qtd_inicial      Int
  entradas         Int?            @default(0)
  saidas           Int?            @default(0)
  em_estoque       Int?
  valor_vista      Decimal? // à vista (débito)
  valor_parcelado  Decimal? // parcelado 10x
  marca            marca           @relation(fields: [marca_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  garantias        garantias[]
  movimentacoes    movimentacoes[]

  @@index([marca_id], map: "idx_estoque_marca")
}

model movimentacoes {
  id                Int       @id @default(autoincrement())
  produto_id        Int
  garantia_id       Int?
  tipo              String // ENTRADA | SAIDA
  quantidade        Int
  valor_final       Decimal
  motivo            String?
  vendedor          String? // vendedor responsável (saídas)
  // Venda (SAIDA): dinheiro | pix | debito | credito. parcelas só em crédito (1–10).
  forma_pagamento   String?
  parcelas          Int?
  // PAGO | FIADO — enum nativo no MySQL, String aqui (SQLite não tem enum),
  // mesmo tratamento de `tipo`. Não muda faturamento (competência) nem comissão.
  status_pagamento  String    @default("PAGO")
  // Quando o fiado foi quitado; NULL na venda paga na hora e no fiado aberto.
  data_pagamento    DateTime?
  // Nome do cliente que levou fiado (texto livre; VarChar(150) no MySQL).
  // Não existe cadastro de cliente — o dado é para ler na tela e cobrar.
  cliente_fiado     String?
  data_movimentacao DateTime? @default(now())
  user_id           Int?
  created_by        String? // nome/email do usuário no momento da criação
  estoque           estoque   @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([produto_id], map: "fk_produto")
  @@index([garantia_id], map: "idx_mov_garantia")
  @@index([motivo], map: "idx_mov_motivo")
  @@index([status_pagamento], map: "idx_mov_status_pagamento")
}

model garantias {
  id                 Int       @id @default(autoincrement())
  cliente_nome       String
  cliente_documento  String
  cliente_telefone   String
  cliente_endereco   String
  produto_codigo     String
  produto_descricao  String
  estoque_id         Int?
  data_abertura      DateTime  @default(now())
  data_limite        DateTime?
  data_contato       DateTime?
  data_compra        DateTime?
  status             String    @default("AGUARDANDO_ENVIO") // AGUARDANDO_ENVIO | RECOLHIDA | EM_LOJA | FINALIZADA
  descricao_problema String?
  // Resultado do teste da distribuidora (fase EM_LOJA): NOVA | MESMA. laudo =
  // parecer em texto livre. Anexo de arquivo fica para evolução futura.
  resultado          String?
  laudo              String?
  // Empréstimo (bateria cedida ao cliente enquanto o produto está em garantia).
  // Eixo independente do status acima. Sem estes campos a baixa de estoque da
  // ida seria irreversível.
  emprestimo_produto_id   Int?
  emprestimo_quantidade   Int?
  emprestimo_devolvido    Boolean   @default(false)
  emprestimo_devolvido_at DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now())
  estoque            estoque?  @relation(fields: [estoque_id], references: [id])

  @@index([estoque_id], map: "fk_garantias_estoque")
  @@index([data_limite], map: "idx_garantias_data_limite")
}

model user {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  password           String // hash
  role               String    @default("user")
  // Permissões granulares por tela (JSON de booleans, ex.: {"home":true}).
  // Chave ausente = false. role=admin BYPASSA tudo (não depende deste campo).
  // Catálogo de chaves válidas: src/utils/permissoes.js (fonte única).
  permissoes         String    @default("{}")
  reset_token        String? // sha256 do token de redefinição de senha (uso único)
  reset_token_expira DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt
}

model estoque_som {
  id               Int                 @id @default(autoincrement())
  produto          String
  modelo           String
  marca_id         Int
  custo            Decimal
  valor_venda      Decimal
  percentual_lucro Decimal?
  qtd_minima       Int
  garantia         String?
  qtd_inicial      Int
  entradas         Int?                @default(0)
  saidas           Int?                @default(0)
  em_estoque       Int?
  valor_vista      Decimal? // à vista (débito)
  valor_parcelado  Decimal? // parcelado 10x
  created_at       DateTime?
  updated_at       DateTime?
  marca            marca               @relation(fields: [marca_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movimentacoes    movimentacoes_som[]

  @@index([marca_id], map: "idx_estoque_som_marca")
  @@map("estoque_som")
}

model movimentacoes_som {
  id                Int         @id @default(autoincrement())
  produto_id        Int
  garantia_id       Int?
  tipo              String // ENTRADA | SAIDA
  quantidade        Int
  valor_final       Decimal
  motivo            String?
  data_movimentacao DateTime?   @default(now())
  user_id           Int?
  created_by        String? // nome/email do usuário no momento da criação
  estoque           estoque_som @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([produto_id], map: "idx_mov_som_produto")
  @@index([garantia_id], map: "idx_mov_som_garantia")
  @@index([motivo], map: "idx_mov_som_motivo")
  @@map("movimentacoes_som")
}

model pedido_som {
  id              Int               @id @default(autoincrement())
  veiculo         String?
  valor_total     Decimal
  valor_mao_obra  Decimal? // total de mão de obra (Som + Insulfilme)
  valor_mao_obra_insulfilme Decimal? // porção Insulfilme (Som = total − esta)
  comissao_joel   Decimal? // som×%som + insulfilme×%insulfilme
  // Rótulo do pagamento ("PIX", "Crédito 10x"…). parcelas só no crédito (1–10),
  // espelhando movimentacoes (Baterias). NÃO afeta preço.
  forma_pagamento String?
  parcelas        Int?
  user_id         Int?
  created_by      String?
  created_at      DateTime          @default(now())
  itens           pedido_som_item[]

  @@map("pedido_som")
}

model pedido_som_item {
  id             Int         @id @default(autoincrement())
  pedido_id      Int
  tipo           String // PRODUTO | MAO_OBRA
  produto_id     Int? // null para mão de obra
  descricao      String // nome livre do serviço, digitado no lançamento
  quantidade     Int        @default(1)
  valor_unit     Decimal
  valor_total    Decimal
  mao_obra_unit  Decimal? // mão de obra unitária digitada no pedido
  mao_obra_total Decimal? // quantidade × mao_obra_unit
  // % da comissão do Joel DESTE item, congelada na venda. É a fonte de verdade
  // da apuração (ver apurar() em comissao.routes.js). NULL só em item anterior
  // à migração de 17/08/2026, e nesse caso a apuração cai no % da config.
  percentual_comissao Decimal?
  baixa_estoque  Boolean    @default(false)
  pedido         pedido_som @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@index([pedido_id], map: "idx_pedido_som_item_pedido")
  @@index([produto_id], map: "idx_pedido_som_item_produto")
  @@map("pedido_som_item")
}

model conferencia_estoque {
  id            Int                @id @default(autoincrement())
  linha         String // BATERIAS | SOM
  status        String             @default("EM_ANDAMENTO") // EM_ANDAMENTO | FINALIZADA
  user_id       Int
  created_by    String
  created_at    DateTime           @default(now())
  finalizada_at DateTime?
  // Quem FINALIZOU (≠ created_by, que é quem iniciou: com pausar/retomar podem
  // ser pessoas diferentes).
  finalizada_por_id Int?
  finalizada_por    String?
  // Resumo CONGELADO na finalização: continua verdadeiro para sempre e a
  // listagem não precisa carregar os itens. NULL = conferência anterior a este
  // registro (a tela mostra "—", sem inventar número retroativo).
  total_itens        Int?
  total_conferidos   Int?
  total_divergencias Int?
  itens         conferencia_item[]

  @@index([linha], map: "idx_conf_linha")
  @@index([status], map: "idx_conf_status")
  @@index([user_id], map: "idx_conf_user")
}

model conferencia_item {
  id             Int                 @id @default(autoincrement())
  conferencia_id Int
  produto_id     Int
  linha          String // BATERIAS | SOM
  qtd_sistema    Int
  // Quantidade REAL contada. NULL = não conferido. Um toque ("bateu") grava
  // qtd_contada = qtd_sistema; "Divergiu" grava o número digitado.
  qtd_contada    Int?
  conferido      Boolean             @default(false)
  conferido_at   DateTime?
  conferencia    conferencia_estoque @relation(fields: [conferencia_id], references: [id], onDelete: Cascade)

  @@index([conferencia_id], map: "idx_conf_item_conferencia")
  @@index([produto_id], map: "idx_conf_item_produto")
}

// ---- Comissão de vendedores (fechamento quinzenal: dia 1–15 e 16–fim do mês) ----
// Config editável pela gestão. percentual_mao_obra é guardado como PERCENTUAL
// (ex.: 30.00 = 30%); o cálculo divide por 100.
model comissao_config {
  id                    Int      @id @default(autoincrement())
  valor_bateria         Decimal // R$ fixos por bateria vendida (Gustavo/Ismael)
  percentual_mao_obra   Decimal // % sobre a mão de obra de Som (Joel)
  percentual_insulfilme Decimal  @default(25) // % sobre Insulfilme (Joel)
  updated_at            DateTime @default(now())
  updated_by            String?
}

// ---- Taxas de maquininha (percentuais 0–100; ex.: 1.36 = 1,36%) ----
// Singleton editável só por admin. Usada pelo /movimentacoes/resumo para
// calcular taxa e lucro líquido no servidor (modelo em src/utils/taxas.js).
model taxas_config {
  id                  Int      @id @default(autoincrement())
  pix_pct             Decimal
  debito_pct          Decimal
  credito_avista_pct  Decimal // crédito 1x
  credito_2a6_pct     Decimal // intermediação 2x–6x (sem antecipação)
  credito_7a12_pct    Decimal // intermediação 7x–12x (sem antecipação)
  antecipacao_mes_pct Decimal // % ao mês (desconto composto a valor presente)
  updated_at          DateTime @default(now())
  updated_by          String?
}

// Histórico de um período já fechado. Snapshot: não é recalculado depois.
model comissao_periodo {
  id          Int                     @id @default(autoincrement())
  data_inicio DateTime
  data_fim    DateTime
  fechado_at  DateTime                @default(now())
  itens       comissao_periodo_item[]

  @@index([data_inicio], map: "idx_comissao_periodo_inicio")
}

model comissao_periodo_item {
  id                 Int              @id @default(autoincrement())
  periodo_id         Int
  vendedor           String
  qtd_baterias       Int              @default(0)
  base_mao_obra      Decimal          @default(0) // base TOTAL de mão de obra (Joel)
  valor_comissao     Decimal          @default(0)
  snap_valor_bateria Decimal // config vigente no fechamento (auditoria)
  // % efetiva do período = valor_comissao / base_mao_obra × 100. Com % livre por
  // item não existe mais um percentual único; esta é a média ponderada, e serve
  // para a UI explicar o número sem reabrir os itens.
  snap_percentual_efetivo Decimal?
  // ---- legado do modelo de dois baldes (SOM/INSULFILME), encerrado em
  // 17/08/2026. Nenhum código novo escreve ou lê estes campos; são a única prova
  // do que já foi pago nos períodos fechados antes da mudança. Ver
  // 2026-08-17-classe-som-parte1-percentual-item.sql.
  base_insulfilme    Decimal          @default(0)
  snap_percentual    Decimal          @default(0)
  snap_percentual_insulfilme Decimal  @default(0)
  periodo            comissao_periodo @relation(fields: [periodo_id], references: [id], onDelete: Cascade)

  @@index([periodo_id], map: "idx_comissao_periodo_item_periodo")
}

/// Diário append-only de exclusão/edição de venda — espelha o schema.mysql.
/// Ver lá a justificativa completa (tabela à parte, sem FK, conteudo_anterior
/// como String em AMBOS os schemas para não divergir dev/prod).
model venda_auditoria {
  id                Int      @id @default(autoincrement())
  linha             String // baterias | som
  entidade          String // movimentacoes | movimentacoes_som | pedido_som
  entidade_id       Int
  acao              String // EXCLUSAO | EDICAO
  conteudo_anterior String // JSON.stringify do estado anterior
  user_id           Int?
  feito_por         String?
  feito_em          DateTime @default(now())

  @@index([entidade, entidade_id], map: "idx_venda_auditoria_entidade")
  @@map("venda_auditoria")
}
